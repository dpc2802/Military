# Base de Datos (Neon Serverless PostgreSQL)
# Obtené la URL en: https://console.neon.tech → tu proyecto → Connection string
DATABASE_URL="postgresql://usuario:password@ep-xxxxx.us-east-2.aws.neon.tech/sgbmilitary?sslmode=require"

# Clave secreta para iron-session (mínimo 32 caracteres)
# Generá una: openssl rand -base64 32
SESSION_SECRET="CAMBIAR_a_una_cadena_aleatoria_de_minimo_32_caracteres_aqui"

# Resend (notificaciones de email al admin)
# Obtené tu API Key en: https://resend.com → API Keys
RESEND_API_KEY="re_XXXXXXXXXXXXXXXXXXXXXXXXXX"

# Uploadthing (subida de imágenes de productos)
# Obtené credenciales en: https://uploadthing.com → tu app
UPLOADTHING_SECRET="TU_SECRET_DE_UPLOADTHING"
UPLOADTHING_APP_ID="XXXXXXXXXX"

# Configuración pública del sitio
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_WHATSAPP_NUMBER="573001234567"
NEXT_PUBLIC_ADMIN_EMAIL="admin@sgbmilitary.com"

# Credenciales del admin (se usan al ejecutar db:seed)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="CambiarEstaContraseñaAntesDeProd"

